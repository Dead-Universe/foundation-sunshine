+struct publisher::impl {
+  std::mutex mutex;
+  std::condition_variable ready;
+  std::thread thread;
+  HWND window = nullptr;
+  bool initialized = false;
+  HRESULT status = E_PENDING;
+  IDataObject *current = nullptr;
+  std::shared_ptr<offer> current_offer;
+  publisher::clipboard_change observer;
+  DWORD last_sequence = 0;
+  unsigned clipboard_retries = 0;
+  bool locked = false;
+  void changed(HWND window) {
+    if (!observer) return;
+    DWORD sequence = GetClipboardSequenceNumber();
+    if (sequence == last_sequence) return;
+    if (current && OleIsCurrentClipboard(current) == S_OK) { last_sequence = sequence; return; }
+    if (current_offer) current_offer->valid = false;
+    if (locked || !interactive_desktop_available()) {
+      last_sequence = sequence;
+      observer(sequence, {});
+      return;
+    }
+    if (!OpenClipboard(window)) {
+      if (++clipboard_retries <= 10) SetTimer(window, 1, 100, nullptr);
+      return;
+    }
+    std::vector<std::wstring> paths;
+    bool copy = true;
+    HANDLE effect = GetClipboardData(effect_format());
+    if (effect && GlobalSize(effect) >= sizeof(DWORD)) {
+      if (auto *value = static_cast<DWORD *>(GlobalLock(effect))) {
+        copy = (*value & DROPEFFECT_MOVE) == 0;
+        GlobalUnlock(effect);
+      }
+    }
+    if (copy && IsClipboardFormatAvailable(CF_HDROP)) {
+      const bool shell_files = IsClipboardFormatAvailable(RegisterClipboardFormatW(L"Shell IDList Array"));
+      const bool image = IsClipboardFormatAvailable(CF_DIB) || IsClipboardFormatAvailable(CF_DIBV5) ||
+                         IsClipboardFormatAvailable(RegisterClipboardFormatW(L"PNG"));
+      if (image && !shell_files) copy = false;
+    }
+    if (copy && IsClipboardFormatAvailable(CF_HDROP)) {
+      HDROP drop = static_cast<HDROP>(GetClipboardData(CF_HDROP));
+      UINT count = drop ? DragQueryFileW(drop, 0xffffffffu, nullptr, 0) : 0;
+      std::size_t path_characters = 0;
+      if (count <= max_entries) {
+        for (UINT i = 0; i < count; ++i) {
+          UINT length = DragQueryFileW(drop, i, nullptr, 0);
+          if (!length || length > 32766 || length > wire::max_manifest_bytes / sizeof(wchar_t) - path_characters) { paths.clear(); break; }
+          path_characters += length;
+          std::vector<wchar_t> path(length + 1);
+          if (DragQueryFileW(drop, i, path.data(), static_cast<UINT>(path.size())) != length) { paths.clear(); break; }
+          paths.emplace_back(path.data());
+        }
+      }
+    }
+    CloseClipboard();
+    clipboard_retries = 0;
+    last_sequence = sequence;
+    observer(sequence, std::move(paths));
+  }
+  struct request { std::shared_ptr<offer> value; HRESULT result = E_PENDING; };
+  static LRESULT CALLBACK procedure(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+    auto *self = reinterpret_cast<impl *>(GetWindowLongPtrW(window, GWLP_USERDATA));
+    if (message == WM_NCCREATE) {
+      self = static_cast<impl *>(reinterpret_cast<CREATESTRUCTW *>(lparam)->lpCreateParams);
+      SetWindowLongPtrW(window, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(self));
+    }
+    if (self && message == WM_APP + 1) {
+      auto &call = *reinterpret_cast<request *>(lparam);
+      IDataObject *object = nullptr;
+      bool changed_clipboard = false;
+      call.result = call.value ? create_data_object(call.value, &object) : S_OK;
+      if (SUCCEEDED(call.result)) {
+        if (object) { call.result = OleSetClipboard(object); changed_clipboard = SUCCEEDED(call.result); }
+        else if (self->current && OleIsCurrentClipboard(self->current) == S_OK) {
+          call.result = OleSetClipboard(nullptr); changed_clipboard = SUCCEEDED(call.result);
+        }
+      }
+      if (SUCCEEDED(call.result)) {
+        if (self->current_offer) self->current_offer->valid = false;
+        if (self->current) self->current->Release();
+        self->current = object;
+        self->current_offer = call.value;
+        if (changed_clipboard) self->last_sequence = GetClipboardSequenceNumber();
+      } else if (object) object->Release();
+      return 0;
+    }
+    if (self && message == WM_APP + 2) { PostQuitMessage(0); return 0; }
+    if (self && message == WM_APP + 3) {
+      self->observer = *reinterpret_cast<publisher::clipboard_change *>(lparam);
+      self->last_sequence = GetClipboardSequenceNumber();
+      return 0;
+    }
+    if (self && message == WM_CLIPBOARDUPDATE) { self->changed(window); return 0; }
+    if (self && message == WM_TIMER && wparam == 1) { KillTimer(window, 1); self->changed(window); return 0; }
+    if (self && message == WM_TIMER && wparam == 2) {
+      const bool unavailable = !interactive_desktop_available();
+      if (unavailable && !self->locked) {
+        self->locked = true;
+        request clear;
+        SendMessageW(window, WM_APP + 1, 0, reinterpret_cast<LPARAM>(&clear));
+        if (self->observer) self->observer(GetClipboardSequenceNumber(), {});
+      } else if (!unavailable) self->locked = false;
+      return 0;
+    }
+    if (self && message == WM_WTSSESSION_CHANGE) {
+      if (wparam == WTS_SESSION_LOCK || wparam == WTS_SESSION_LOGOFF || wparam == WTS_CONSOLE_DISCONNECT || wparam == WTS_REMOTE_DISCONNECT) {
+        self->locked = true;
+        if (self->current_offer) self->current_offer->valid = false;
+        request clear;
+        SendMessageW(window, WM_APP + 1, 0, reinterpret_cast<LPARAM>(&clear));
+        if (self->observer) self->observer(GetClipboardSequenceNumber(), {});
+      } else if (wparam == WTS_SESSION_UNLOCK || wparam == WTS_SESSION_LOGON || wparam == WTS_CONSOLE_CONNECT || wparam == WTS_REMOTE_CONNECT) self->locked = false;
+      return 0;
+    }
+    return DefWindowProcW(window, message, wparam, lparam);
+  }
+  impl() {
+    thread = std::thread([this] {
+      HRESULT apartment = OleInitialize(nullptr);
+      HWND created = nullptr;
+      if (SUCCEEDED(apartment)) {
+        WNDCLASSW type {};
+        type.lpfnWndProc = procedure;
+        type.hInstance = GetModuleHandleW(nullptr);
+        type.lpszClassName = L"StreamingFileClipboardSTA";
+        if (RegisterClassW(&type) || GetLastError() == ERROR_CLASS_ALREADY_EXISTS) {
+          created = CreateWindowExW(0, type.lpszClassName, L"", 0, 0, 0, 0, 0,
+                                    HWND_MESSAGE, nullptr, type.hInstance, this);
+        }
+      }
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        window = created;
+        initialized = true;
+        status = FAILED(apartment) ? apartment : created ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+      }
+      ready.notify_all();
+      if (FAILED(apartment)) return;
+      if (!created) { OleUninitialize(); return; }
+      AddClipboardFormatListener(created);
+      WTSRegisterSessionNotification(created, NOTIFY_FOR_THIS_SESSION);
+      SetTimer(created, 2, 250, nullptr);
+      MSG message;
+      while (GetMessageW(&message, nullptr, 0, 0) > 0) {
+        TranslateMessage(&message); DispatchMessageW(&message);
+      }
+      if (current) {
+        if (OleIsCurrentClipboard(current) == S_OK) OleSetClipboard(nullptr);
+        current->Release(); current = nullptr;
+      }
+      WTSUnRegisterSessionNotification(created);
+      RemoveClipboardFormatListener(created);
+      DestroyWindow(created);
+      OleUninitialize();
+    });
+    std::unique_lock<std::mutex> lock(mutex);
+    ready.wait(lock, [&] { return initialized; });
+  }
+  ~impl() {
+    if (thread.joinable()) {
+      if (window) {
+        request clear;
+        SendMessageW(window, WM_APP + 1, 0, reinterpret_cast<LPARAM>(&clear));
+        PostMessageW(window, WM_APP + 2, 0, 0);
+      }
+      thread.join();
+    }
+  }
+};
+
+publisher::publisher(): state_(std::make_unique<impl>()) {}
+publisher::~publisher() = default;
+HRESULT publisher::publish(std::shared_ptr<offer> value) {
+  if (FAILED(state_->status)) return state_->status;
+  impl::request call {std::move(value), E_PENDING};
+  // SendMessage dispatches incoming nonqueued messages while waiting. A bare
+  // condition-variable wait here would deadlock if this caller owned the
+  // previous clipboard and OLE sent it WM_DESTROYCLIPBOARD during replacement.
+  SendMessageW(state_->window, WM_APP + 1, 0, reinterpret_cast<LPARAM>(&call));
+  return call.result;
+}
+void publisher::clear() { publish({}); }
+void publisher::observe(clipboard_change callback) {
+  if (SUCCEEDED(state_->status)) SendMessageW(state_->window, WM_APP + 3, 0, reinterpret_cast<LPARAM>(&callback));
+}
+}
diff --git a/src/file_clipboard/file_clipboard_native.h b/src/file_clipboard/file_clipboard_native.h
new file mode 100644
index 00000000..fba45b1a
--- /dev/null
+++ b/src/file_clipboard/file_clipboard_native.h
@@ -0,0 +1,79 @@
+#pragma once
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <objidl.h>
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace streaming::file_clipboard {
+inline constexpr std::size_t max_entries = 20000;
+inline constexpr ULONG max_chunk_bytes = 1024 * 1024;
+
+struct entry {
+  std::wstring relative_path;
+  std::uint64_t size = 0;
+  DWORD attributes = FILE_ATTRIBUTE_NORMAL;
+  FILETIME last_write {};
+  bool directory() const { return (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0; }
+};
+
+// The transport must authenticate the offer and supply bounded reads. No
+// destination path or arbitrary source path is accepted by this interface.
+class reader {
+public:
+  virtual ~reader() = default;
+  virtual HRESULT read_at(std::size_t index, std::uint64_t offset,
+                          void *buffer, ULONG requested, ULONG &received) = 0;
+};
+
+struct offer {
+  std::vector<entry> entries;
+  std::shared_ptr<reader> source;
+  std::atomic<bool> valid {true};
+};
+
+bool valid_relative_path(const std::wstring &path);
+HRESULT create_data_object(std::shared_ptr<offer> value, IDataObject **result);
+bool interactive_desktop_available();
+
+class source_files final : public reader {
+public:
+  static HRESULT collect(const std::vector<std::wstring> &paths,
+                         const std::function<bool()> &cancelled,
+                         std::shared_ptr<source_files> &result);
+  ~source_files();
+  const std::vector<entry> &entries() const;
+  HRESULT read_at(std::size_t index, std::uint64_t offset,
+                  void *buffer, ULONG requested, ULONG &received) override;
+private:
+  struct impl;
+  source_files();
+  std::unique_ptr<impl> state_;
+};
+
+// Owns a dedicated OLE STA. Network/source callbacks may run on COM worker
+// threads and must not depend on this thread's message pump to make progress.
+class publisher {
+public:
+  publisher();
+  ~publisher();
+  publisher(const publisher &) = delete;
+  publisher &operator=(const publisher &) = delete;
+  HRESULT publish(std::shared_ptr<offer> value);
+  void clear();
+  using clipboard_change = std::function<void(std::uint32_t, std::vector<std::wstring>)>;
+  void observe(clipboard_change callback);
+private:
+  struct impl;
+  std::unique_ptr<impl> state_;
+};
+}
diff --git a/src/file_clipboard/file_clipboard_pipe.h b/src/file_clipboard/file_clipboard_pipe.h
new file mode 100644
index 00000000..4c60cb45
--- /dev/null
+++ b/src/file_clipboard/file_clipboard_pipe.h
@@ -0,0 +1,59 @@
+#pragma once
+#include "file_clipboard_wire.h"
+#include <chrono>
+
+namespace streaming::file_clipboard::wire {
+class pipe {
+public:
+  explicit pipe(HANDLE handle, bool server = false): handle_(handle), server_(server) {}
+  ~pipe() { stop(); if (handle_ != INVALID_HANDLE_VALUE) CloseHandle(handle_); }
+  bool alive() const { return alive_.load(); }
+  void stop() {
+    if (alive_.exchange(false)) {
+      CancelIoEx(handle_, nullptr);
+      if (server_) DisconnectNamedPipe(handle_);
+    }
+  }
+  bool send(const message &value) {
+    auto data = encode(value);
+    std::lock_guard<std::mutex> lock(write_mutex_);
+    return !data.empty() && transfer(data.data(), static_cast<DWORD>(data.size()), true);
+  }
+  bool receive(message &value) {
+    bytes data(16);
+    if (!transfer(data.data(), 16, false)) return false;
+    decoder header(data); std::uint64_t type, id, length;
+    if (!header.number(type, 4) || !header.number(id, 8) || !header.number(length, 4) || length > max_manifest_bytes) { stop(); return false; }
+    data.resize(16 + static_cast<std::size_t>(length));
+    if (length && !transfer(data.data() + 16, static_cast<DWORD>(length), false)) return false;
+    if (!decode(data, value)) { stop(); return false; }
+    return true;
+  }
+private:
+  bool transfer(void *buffer, DWORD bytes, bool writing) {
+    auto *position = static_cast<unsigned char *>(buffer);
+    while (bytes && alive_) {
+      OVERLAPPED operation {}; operation.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+      if (!operation.hEvent) { stop(); return false; }
+      DWORD count = 0;
+      BOOL complete = writing ? WriteFile(handle_, position, bytes, &count, &operation) : ReadFile(handle_, position, bytes, &count, &operation);
+      DWORD error = complete ? ERROR_SUCCESS : GetLastError();
+      if (!complete && error == ERROR_IO_PENDING) {
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(15);
+        while (alive_) {
+          auto wait = WaitForSingleObject(operation.hEvent, 250);
+          if (wait == WAIT_OBJECT_0) break;
+          if (wait != WAIT_TIMEOUT || (writing && std::chrono::steady_clock::now() >= deadline)) { stop(); break; }
+        }
+        if (!alive_) CancelIoEx(handle_, &operation);
+        complete = GetOverlappedResult(handle_, &operation, &count, TRUE);
+      }
+      CloseHandle(operation.hEvent);
+      if (!complete || !count) { stop(); return false; }
+      bytes -= count; position += count;
+    }
+    return bytes == 0 && alive_;
+  }
+  HANDLE handle_; bool server_; std::atomic<bool> alive_ {true}; std::mutex write_mutex_;
+};
+}
diff --git a/src/file_clipboard/file_clipboard_source.cpp b/src/file_clipboard/file_clipboard_source.cpp
new file mode 100644
index 00000000..69f0fbbc
--- /dev/null
+++ b/src/file_clipboard/file_clipboard_source.cpp
@@ -0,0 +1,163 @@
+#include "file_clipboard_native.h"
+#include "file_clipboard_wire.h"
+#include <filesystem>
+#include <set>
+
+namespace streaming::file_clipboard {
+namespace {
+std::wstring extended(const std::wstring &path) {
+  if (path.rfind(L"\\\\?\\", 0) == 0) return path;
+  if (path.rfind(L"\\\\", 0) == 0) return L"\\\\?\\UNC\\" + path.substr(2);
+  return L"\\\\?\\" + path;
+}
+struct handle {
+  HANDLE value = INVALID_HANDLE_VALUE;
+  ~handle() { if (value != INVALID_HANDLE_VALUE) CloseHandle(value); }
+};
+struct ordinal_less {
+  bool operator()(const std::wstring &a, const std::wstring &b) const {
+    return CompareStringOrdinal(a.c_str(), static_cast<int>(a.size()), b.c_str(), static_cast<int>(b.size()), TRUE) == CSTR_LESS_THAN;
+  }
+};
+HRESULT full_path(const std::wstring &input, std::wstring &output) {
+  DWORD count = GetFullPathNameW(input.c_str(), 0, nullptr, nullptr);
+  if (!count || count > 32767) return E_INVALIDARG;
+  std::vector<wchar_t> buffer(count);
+  if (!GetFullPathNameW(input.c_str(), count, buffer.data(), nullptr)) return HRESULT_FROM_WIN32(GetLastError());
+  output = buffer.data();
+  while (output.size() > 3 && output.back() == L'\\') output.pop_back();
+  auto parent = std::filesystem::path(output);
+  while (!parent.empty()) {
+    auto attributes = GetFileAttributesW(extended(parent.wstring()).c_str());
+    if (attributes == INVALID_FILE_ATTRIBUTES) return HRESULT_FROM_WIN32(GetLastError());
+    if (attributes & FILE_ATTRIBUTE_REPARSE_POINT) return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+    auto next = parent.parent_path();
+    if (next == parent) break;
+    parent = next;
+  }
+  return S_OK;
+}
+}
+
+bool interactive_desktop_available() {
+  DWORD session = MAXDWORD;
+  if (!ProcessIdToSessionId(GetCurrentProcessId(), &session) || session != WTSGetActiveConsoleSessionId()) return false;
+  HDESK desktop = OpenInputDesktop(0, FALSE, DESKTOP_READOBJECTS);
+  if (!desktop) return false;
+  wchar_t name[128] {};
+  DWORD bytes = 0;
+  BOOL success = GetUserObjectInformationW(desktop, UOI_NAME, name, sizeof(name), &bytes);
+  CloseDesktop(desktop);
+  return success && CompareStringOrdinal(name, -1, L"Default", -1, TRUE) == CSTR_EQUAL;
+}
+
+struct source_files::impl {
+  struct fingerprint {
+    std::wstring path;
+    BY_HANDLE_FILE_INFORMATION information {};
+  };
+  std::vector<entry> entries;
+  std::vector<fingerprint> files;
+  std::set<std::wstring, ordinal_less> names;
+  std::size_t path_characters = 0;
+  HRESULT append(const std::wstring &path, const std::wstring &relative,
+                 const std::function<bool()> &cancelled, unsigned depth) {
+    if (cancelled && cancelled()) return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    if (depth > 64 || entries.size() >= max_entries || !valid_relative_path(relative)) return E_INVALIDARG;
+    if (path.size() > wire::max_manifest_bytes / sizeof(wchar_t) - path_characters) return E_OUTOFMEMORY;
+    path_characters += path.size();
+    if (!names.insert(relative).second) return HRESULT_FROM_WIN32(ERROR_DUP_NAME);
+    WIN32_FILE_ATTRIBUTE_DATA attributes {};
+    if (!GetFileAttributesExW(extended(path).c_str(), GetFileExInfoStandard, &attributes)) return HRESULT_FROM_WIN32(GetLastError());
+    if (attributes.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DEVICE)) return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+    entry descriptor;
+    descriptor.relative_path = relative;
+    descriptor.attributes = attributes.dwFileAttributes &
+        (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_ARCHIVE | FILE_ATTRIBUTE_SYSTEM);
+    if (!descriptor.attributes) descriptor.attributes = FILE_ATTRIBUTE_NORMAL;
+    descriptor.last_write = attributes.ftLastWriteTime;
+    fingerprint identity;
+    identity.path = extended(path);
+    if (!descriptor.directory()) {
+      handle file;
+      file.value = CreateFileW(identity.path.c_str(), FILE_READ_ATTRIBUTES,
+                               FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                               nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+      if (file.value == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+      if (!GetFileInformationByHandle(file.value, &identity.information)) return HRESULT_FROM_WIN32(GetLastError());
+      if (identity.information.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
+      descriptor.size = (static_cast<std::uint64_t>(identity.information.nFileSizeHigh) << 32) | identity.information.nFileSizeLow;
+      descriptor.last_write = identity.information.ftLastWriteTime;
+    }
+    entries.push_back(descriptor);
+    files.push_back(std::move(identity));
+    if (!descriptor.directory()) return S_OK;
+    WIN32_FIND_DATAW found {};
+    HANDLE search = FindFirstFileW(extended(path + L"\\*").c_str(), &found);
+    if (search == INVALID_HANDLE_VALUE) {
+      DWORD error = GetLastError();
+      return error == ERROR_FILE_NOT_FOUND ? S_OK : HRESULT_FROM_WIN32(error);
+    }
+    std::set<std::wstring, ordinal_less> children;
+    do {
+      if (std::wstring(found.cFileName) != L"." && std::wstring(found.cFileName) != L"..") children.insert(found.cFileName);
+      if (children.size() + entries.size() > max_entries || (cancelled && cancelled())) {
+        FindClose(search); return HRESULT_FROM_WIN32(ERROR_CANCELLED);
+      }
+    } while (FindNextFileW(search, &found));
+    DWORD error = GetLastError();
+    FindClose(search);
+    if (error != ERROR_NO_MORE_FILES) return HRESULT_FROM_WIN32(error);
+    for (const auto &child : children) {
+      HRESULT status = append(path + L"\\" + child, relative + L"\\" + child, cancelled, depth + 1);
+      if (FAILED(status)) return status;
+    }
+    return S_OK;
+  }
+};
+
+source_files::source_files(): state_(std::make_unique<impl>()) {}
+source_files::~source_files() = default;
+const std::vector<entry> &source_files::entries() const { return state_->entries; }
+HRESULT source_files::collect(const std::vector<std::wstring> &paths,
+                              const std::function<bool()> &cancelled,
+                              std::shared_ptr<source_files> &result) {
+  result.reset();
+  if (paths.empty() || paths.size() > max_entries || !interactive_desktop_available()) return E_ACCESSDENIED;
+  auto collection = std::shared_ptr<source_files>(new source_files);
+  for (const auto &path : paths) {
+    std::wstring full;
+    HRESULT status = full_path(path, full);
+    if (FAILED(status)) return status;
+    auto name = std::filesystem::path(full).filename().wstring();
+    status = collection->state_->append(full, name, cancelled, 0);
+    if (FAILED(status)) return status;
+  }
+  result = std::move(collection);
+  return S_OK;
+}
+HRESULT source_files::read_at(std::size_t index, std::uint64_t offset,
+                             void *buffer, ULONG requested, ULONG &received) {
+  received = 0;
+  if (!interactive_desktop_available()) return E_ACCESSDENIED;
+  if (index >= state_->entries.size() || state_->entries[index].directory() || requested > max_chunk_bytes) return E_INVALIDARG;
+  const auto &descriptor = state_->entries[index];
+  if (offset > descriptor.size || requested > descriptor.size - offset) return E_INVALIDARG;
+  const auto &identity = state_->files[index];
+  handle file;
+  file.value = CreateFileW(identity.path.c_str(), GENERIC_READ, FILE_SHARE_READ,
+                           nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  if (file.value == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
+  BY_HANDLE_FILE_INFORMATION current {};
+  if (!GetFileInformationByHandle(file.value, &current)) return HRESULT_FROM_WIN32(GetLastError());
+  const auto &before = identity.information;
+  if ((current.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)) ||
+      current.dwVolumeSerialNumber != before.dwVolumeSerialNumber || current.nFileIndexHigh != before.nFileIndexHigh ||
+      current.nFileIndexLow != before.nFileIndexLow || current.nFileSizeHigh != before.nFileSizeHigh ||
+      current.nFileSizeLow != before.nFileSizeLow || CompareFileTime(&current.ftLastWriteTime, &before.ftLastWriteTime) != 0) return STG_E_REVERTED;
+  LARGE_INTEGER position; position.QuadPart = static_cast<LONGLONG>(offset);
+  if (!SetFilePointerEx(file.value, position, nullptr, FILE_BEGIN)) return HRESULT_FROM_WIN32(GetLastError());
+  if (!ReadFile(file.value, buffer, requested, &received, nullptr)) return HRESULT_FROM_WIN32(GetLastError());
+  return received == requested ? S_OK : STG_E_READFAULT;
+}
+}
diff --git a/src/file_clipboard/file_clipboard_wire.h b/src/file_clipboard/file_clipboard_wire.h
new file mode 100644
index 00000000..4008d120
--- /dev/null
+++ b/src/file_clipboard/file_clipboard_wire.h
@@ -0,0 +1,155 @@
+#pragma once
+#include "file_clipboard_native.h"
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <set>
+#include <thread>
+
+namespace streaming::file_clipboard::wire {
+using bytes = std::vector<unsigned char>;
+inline constexpr std::size_t max_manifest_bytes = 16 * 1024 * 1024;
+enum class kind : std::uint32_t { hello = 1, offer = 2, request = 3, reply = 4, publish = 5 };
+struct message { kind type {}; std::uint64_t id = 0; bytes body; };
+inline void number(bytes &out, std::uint64_t value, unsigned count) {
+  for (unsigned i = 0; i < count; ++i) out.push_back(static_cast<unsigned char>(value >> (i * 8)));
+}
+struct decoder {
+  const unsigned char *data; std::size_t size, position = 0;
+  explicit decoder(const bytes &in): data(in.data()), size(in.size()) {}
+  bool number(std::uint64_t &value, unsigned count) {
+    if (count > 8 || count > size - position) return false;
+    value = 0;
+    for (unsigned i = 0; i < count; ++i) value |= std::uint64_t(data[position++]) << (i * 8);
+    return true;
+  }
+  bool done() const { return position == size; }
+};
+inline bytes encode(const message &value) {
+  if (value.body.size() > max_manifest_bytes) return {};
+  bytes out; out.reserve(16 + value.body.size());
+  number(out, static_cast<std::uint32_t>(value.type), 4);
+  number(out, value.id, 8); number(out, value.body.size(), 4);
+  out.insert(out.end(), value.body.begin(), value.body.end());
+  return out;
+}
+inline bool decode(const bytes &data, message &value) {
+  decoder input(data); std::uint64_t type, size;
+  if (!input.number(type, 4) || !input.number(value.id, 8) || !input.number(size, 4) ||
+      type < 1 || type > 5 || size > max_manifest_bytes || size != data.size() - input.position) return false;
+  value.type = static_cast<kind>(type);
+  value.body.assign(data.begin() + input.position, data.end()); return true;
+}
+struct ordinal_less {
+  bool operator()(const std::wstring &a, const std::wstring &b) const {
+    return CompareStringOrdinal(a.c_str(), static_cast<int>(a.size()), b.c_str(), static_cast<int>(b.size()), TRUE) == CSTR_LESS_THAN;
+  }
+};
+inline bool valid_manifest(const std::vector<entry> &entries) {
+  if (entries.empty() || entries.size() > max_entries) return false;
+  std::set<std::wstring, ordinal_less> names, directories;
+  for (const auto &item : entries) {
+    if (!valid_relative_path(item.relative_path) || !names.insert(item.relative_path).second ||
+        item.size > static_cast<std::uint64_t>(INT64_MAX) || (item.directory() && item.size)) return false;
+    const auto slash = item.relative_path.rfind(L'\\');
+    if (slash != std::wstring::npos && !directories.count(item.relative_path.substr(0, slash))) return false;
+    if (item.attributes & ~(FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN |
+                            FILE_ATTRIBUTE_ARCHIVE | FILE_ATTRIBUTE_SYSTEM | FILE_ATTRIBUTE_NORMAL)) return false;
+    if (item.directory()) directories.insert(item.relative_path);
+  }
+  return true;
+}
+inline bytes manifest(const std::vector<entry> &entries) {
+  if (!valid_manifest(entries)) return {};
+  bytes out; number(out, entries.size(), 4);
+  for (const auto &item : entries) {
+    number(out, item.relative_path.size(), 2);
+    for (wchar_t character : item.relative_path) number(out, static_cast<std::uint16_t>(character), 2);
+    number(out, item.size, 8); number(out, item.attributes, 4);
+    number(out, (std::uint64_t(item.last_write.dwHighDateTime) << 32) | item.last_write.dwLowDateTime, 8);
+    if (out.size() > max_manifest_bytes) return {};
+  }
+  return out;
+}
+inline bool manifest(const bytes &body, std::vector<entry> &entries) {
+  entries.clear(); if (body.size() > max_manifest_bytes) return false;
+  decoder input(body); std::uint64_t count, length, value;
+  if (!input.number(count, 4) || !count || count > max_entries) return false;
+  entries.reserve(static_cast<std::size_t>(count));
+  for (std::uint64_t i = 0; i < count; ++i) {
+    entry item;
+    if (!input.number(length, 2) || !length || length >= MAX_PATH) return false;
+    for (std::uint64_t j = 0; j < length; ++j) {
+      if (!input.number(value, 2)) return false;
+      item.relative_path.push_back(static_cast<wchar_t>(value));
+    }
+    if (!input.number(item.size, 8) || !input.number(value, 4)) return false;
+    item.attributes = static_cast<DWORD>(value);
+    if (!input.number(value, 8)) return false;
+    item.last_write.dwLowDateTime = static_cast<DWORD>(value);
+    item.last_write.dwHighDateTime = static_cast<DWORD>(value >> 32);
+    entries.push_back(std::move(item));
+  }
+  return input.done() && valid_manifest(entries);
+}
+struct read_query { std::uint64_t generation = 0; std::uint32_t index = 0; std::uint64_t offset = 0; std::uint32_t count = 0; };
+inline bytes query(const read_query &value) {
+  bytes out; number(out, value.generation, 8); number(out, value.index, 4);
+  number(out, value.offset, 8); number(out, value.count, 4); return out;
+}
+inline bool query(const bytes &body, read_query &value) {
+  decoder input(body); std::uint64_t index, count;
+  if (!input.number(value.generation, 8) || !input.number(index, 4) || !input.number(value.offset, 8) ||
+      !input.number(count, 4) || !input.done() || count > max_chunk_bytes) return false;
+  value.index = static_cast<std::uint32_t>(index); value.count = static_cast<std::uint32_t>(count); return true;
+}
+inline bool within(const read_query &value, std::uint64_t generation, const std::vector<entry> &entries) {
+  return value.generation && value.generation == generation && value.index < entries.size() &&
+      !entries[value.index].directory() && value.offset <= entries[value.index].size &&
+      value.count <= max_chunk_bytes && value.count <= entries[value.index].size - value.offset;
+}
+inline bytes reply(HRESULT status, const void *data = nullptr, std::size_t size = 0) {
+  bytes out; number(out, static_cast<std::uint32_t>(status), 4);
+  if (data && size <= max_chunk_bytes) out.insert(out.end(), static_cast<const unsigned char *>(data), static_cast<const unsigned char *>(data) + size);
+  return out;
+}
+inline HRESULT reply(const bytes &body, void *data, ULONG count, ULONG &received) {
+  received = 0; decoder input(body); std::uint64_t status;
+  if (!input.number(status, 4) || body.size() - 4 > count) return STG_E_READFAULT;
+  HRESULT result = static_cast<HRESULT>(status);
+  if (FAILED(result)) return result;
+  received = static_cast<ULONG>(body.size() - 4);
+  if (received != count) return STG_E_READFAULT;
+  if (received) std::memcpy(data, body.data() + 4, received);
+  return S_OK;
+}
+
+// Two workers and a bounded queue keep file operations away from UI and video threads.
+class workers {
+public:
+  workers() { for (unsigned i = 0; i < 2; ++i) threads_.emplace_back([this] { run(); }); }
+  ~workers() {
+    { std::lock_guard<std::mutex> lock(mutex_); stop_ = true; queue_.clear(); }
+    ready_.notify_all(); for (auto &thread : threads_) thread.join();
+  }
+  bool post(std::function<void()> task) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (stop_ || queue_.size() >= 8) return false;
+    queue_.push_back(std::move(task)); ready_.notify_one(); return true;
+  }
+private:
+  void run() {
+    for (;;) {
+      std::function<void()> task;
+      { std::unique_lock<std::mutex> lock(mutex_); ready_.wait(lock, [this] { return stop_ || !queue_.empty(); });
+        if (stop_) return;
+        task = std::move(queue_.front()); queue_.pop_front(); }
+      try { task(); } catch (...) { /* A failed offer must not terminate the helper. */ }
+    }
+  }
+  std::mutex mutex_; std::condition_variable ready_; bool stop_ = false;
+  std::deque<std::function<void()>> queue_; std::vector<std::thread> threads_;
+};
+}
