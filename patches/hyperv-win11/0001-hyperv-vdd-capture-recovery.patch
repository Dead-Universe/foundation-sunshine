diff --git a/src/display_device/vdd_output_state.h b/src/display_device/vdd_output_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..c65520328033395c5cee925536d2135acc734e52
--- /dev/null
+++ b/src/display_device/vdd_output_state.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <optional>
+#include <string>
+#include <utility>
+
+namespace display_device {
+
+  // Empty means Auto and is a valid saved selection, not an absent snapshot.
+  class vdd_output_state_t {
+  public:
+    bool remember(const std::string &output_name) {
+      if (original_) {
+        return false;
+      }
+      original_ = output_name;
+      return true;
+    }
+
+    bool restore(std::string &output_name) {
+      if (!original_) {
+        return false;
+      }
+      output_name = std::move(*original_);
+      original_.reset();
+      return true;
+    }
+
+  private:
+    std::optional<std::string> original_;
+  };
+
+}  // namespace display_device
