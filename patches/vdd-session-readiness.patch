@@ -11,0 +12 @@
+#include <mutex>
@@ -12,0 +14 @@
+#include <unordered_map>
@@ -39,0 +42,35 @@ namespace display_device::w_utils {
+    std::mutex session_state_mutex;
+    std::unordered_map<DWORD, bool> session_desktop_ready_cache;
+
+    bool
+    get_cached_session_desktop_ready(DWORD session_id, bool &desktop_ready) {
+      std::lock_guard<std::mutex> lock(session_state_mutex);
+      const auto it = session_desktop_ready_cache.find(session_id);
+      if (it == session_desktop_ready_cache.end()) {
+        return false;
+      }
+
+      desktop_ready = it->second;
+      return true;
+    }
+
+    DWORD
+    find_active_user_session_id() {
+      PWTS_SESSION_INFOW sessions { nullptr };
+      DWORD session_count { 0 };
+      DWORD active_session_id { 0xFFFFFFFF };
+
+      if (WTSEnumerateSessionsW(WTS_CURRENT_SERVER_HANDLE, 0, 1, &sessions, &session_count)) {
+        for (DWORD index = 0; index < session_count; ++index) {
+          const auto &session = sessions[index];
+          if (session.State == WTSActive && session.SessionId != 0) {
+            active_session_id = session.SessionId;
+            break;
+          }
+        }
+        WTSFreeMemory(sessions);
+      }
+
+      return active_session_id != 0xFFFFFFFF ? active_session_id : WTSGetActiveConsoleSessionId();
+    }
+
